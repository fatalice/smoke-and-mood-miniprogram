/* app.wxss — 全局设计令牌 + 基础重置（移植自 demo 的 :root tokens） */

page {
  /* 氛围色 */
  --bg: #0B0F16;
  --phone: #10161F;
  --card: #161E2A;

  /* 强调 */
  --amber: #FFB454;
  --amber-deep: #F08C3A;
  --amber-soft: rgba(255, 180, 84, 0.12);
  --green: #3ECF8E;
  --green-soft: rgba(62, 207, 142, 0.1);
  --red: #FF6B6B;
  --red-soft: rgba(255, 107, 107, 0.1);
  --blue: #7FB4FF;

  /* 文字 */
  --text: #EAF0F7;
  --text2: #9AA8BA;
  --text3: #5F6E80;

  /* 线 */
  --line: rgba(148, 163, 184, 0.14);
  --ring-track: #223045;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  font-variant-numeric: tabular-nums;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: none;
  background: none;
  color: inherit;
  font-family: inherit;
  line-height: normal;
}

button::after {
  border: none;
}

/* 通用工具类 */
.fade-in {
  animation: rise 0.5s ease both;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.16); }
  100% { transform: scale(1); }
}

.pop { animation: pop 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); }

@media (prefers-reduced-motion: reduce) {
  .fade-in, .pop { animation: none !important; }
}
